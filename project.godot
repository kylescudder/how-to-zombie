; Engine configuration file.
config_version=5

[application]

config/name="How to Zombie"
config/description="Four survivors, one way out. Co-op zombie survival in the style of Left 4 Dead."
run/main_scene="res://scenes/main.tscn"
config/features=PackedStringArray("4.7", "Forward Plus")
config/icon="res://assets/icon.svg"

[autoload]

Settings="*res://scripts/autoload/settings.gd"
Sfx="*res://scripts/autoload/sfx.gd"
SteamService="*res://scripts/autoload/steam_service.gd"
Net="*res://scripts/autoload/net.gd"
Game="*res://scripts/autoload/game_state.gd"

[display]

window/size/viewport_width=1600
window/size/viewport_height=900
window/stretch/mode="canvas_items"
window/stretch/aspect="expand"

[layer_names]

3d_physics/layer_1="world"
3d_physics/layer_2="players"
3d_physics/layer_3="zombies"
3d_physics/layer_4="interact"
3d_physics/layer_5="projectiles"

[physics]

common/physics_ticks_per_second=60
3d/physics_engine="Jolt Physics"

[rendering]

anti_aliasing/quality/msaa_3d=2
